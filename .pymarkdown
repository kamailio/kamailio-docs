{
  "extensions": {
    "markdown-tables": {
        "enabled" : true
    }
  },
  "plugins": {
    "per-file-ignores": {
      "kamailio-kemi-framework/docs/modules/**/*.*.md": ["MD041","MD051"]
    },
    "MD004": {
      "enabled": true,
      "style": "sublist"
    },
    "MD013": {
      "enabled": false
    },
    "MD046": {
      "enabled": false
    }
  }
}
